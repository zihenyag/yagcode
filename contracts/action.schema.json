{
  "$defs": {
    "ApplyPatchAction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Action Id",
          "type": "string"
        },
        "generation": {
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "kind": {
          "const": "apply_patch",
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/ApplyPatchPayload"
        },
        "reason_summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason Summary",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "run_id",
        "generation",
        "reason_summary",
        "kind",
        "payload"
      ],
      "title": "ApplyPatchAction",
      "type": "object"
    },
    "ApplyPatchPayload": {
      "additionalProperties": false,
      "properties": {
        "base_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Base Sha256",
          "type": "string"
        },
        "hunks": {
          "items": {
            "$ref": "#/$defs/PatchHunk"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Hunks",
          "type": "array"
        },
        "relative_path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "root_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Root Id",
          "type": "string"
        }
      },
      "required": [
        "root_id",
        "relative_path",
        "base_sha256",
        "hunks"
      ],
      "title": "ApplyPatchPayload",
      "type": "object"
    },
