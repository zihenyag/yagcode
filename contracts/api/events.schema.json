{
  "$defs": {
    "ActionIntentPayload": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ActionIntentPayload",
      "type": "object"
    },
    "RunStatePayload": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "state"
      ],
      "title": "RunStatePayload",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "event_type": {
      "enum": [
        "run.state",
        "action.intent"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "generation": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation"
    },
    "payload": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStatePayload"
        },
        {
          "$ref": "#/$defs/ActionIntentPayload"
        }
      ],
      "title": "Payload"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    }
  },
  "required": [
    "profile_id",
    "sequence",
    "event_type",
    "payload"
  ],
  "title": "EventEnvelope",
  "type": "object"
}
